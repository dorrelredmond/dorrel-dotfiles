{ 
    "hyprland/workspaces": {
    	"active-only": false,
    	"all-outputs": false,
	    "format": "{name}",
	    "show-special": false,
      "persistent-workspaces":{
        "*": 5,
      }
    },

	"hyprland/window": {
    	"format": "{}",
	    "max-length": 25,
	    "separate-outputs": true,
	    "offscreen-css": true,
    	"offscreen-css-text": "(inactive)",
	    "rewrite": {
		    "(.*) — Mozilla Firefox": " $1",
		    "(.*) - fish": "> [$1]",
		    "(.*) - zsh": "> [$1]",
		    "(.*) - $term": "> [$1]"
	    }
    }
}
